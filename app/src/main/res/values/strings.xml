    <!-- Shell texts for this app -->
    <string name="settings_subtitle">Connection and privacy</string>
    <string name="app_lock_subtitle">Ask for an app PIN (and optionally your fingerprint) when opening TalkCtrl. A firmware transfer that\'s running keeps going.</string>
    <string name="app_lock_footer">TalkCtrl talks to your unit over Bluetooth. The only internet use is a firmware check or download you start yourself, to Cardo\'s public update server, sending only the model name. No account, analytics or tracking.</string>
    <string name="lock_prompt_subtitle">Your intercom</string>
    <string name="lock_forgot_body">The PIN can\'t be recovered. TalkCtrl will forget your unit and saved profiles, and turn the app lock off. Nothing on the unit itself is changed.</string>

